# Direct dependencies (human-edited). requirements.txt is the compiled lock that
# Render installs as-is ("pip install -r requirements.txt"), so CI, Render and a
# local install get the same pinned set. Regenerate after editing this file:
#   uv pip compile requirements.in -o requirements.txt --universal --python-version 3.12
# Security floors (pip-audit 11/10/2026): flask PYSEC-2026-2151 -> 3.1.3,
# requests PYSEC-2026-1872 + PYSEC-2026-2275 -> 2.33.0. Never go below these.
flask==3.1.3
requests==2.34.2
